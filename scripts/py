#!/bin/sh
# py — venv 인지 python 리졸버 (POSIX)
# 우선순위: $LF_PYTHON > $LO_PYTHON > $ROOT/.venv/bin/python > $HOME/.lfenv/bin/python > python3
ROOT="$(cd "$(dirname "$0")/.." && pwd)"
if [ -n "${LF_PYTHON:-}" ]; then
  exec "$LF_PYTHON" "$@"
elif [ -n "${LO_PYTHON:-}" ]; then
  exec "$LO_PYTHON" "$@"
elif [ -x "$ROOT/.venv/bin/python" ]; then
  exec "$ROOT/.venv/bin/python" "$@"
elif [ -x "$HOME/.lfenv/bin/python" ]; then
  exec "$HOME/.lfenv/bin/python" "$@"
else
  exec python3 "$@"
fi
