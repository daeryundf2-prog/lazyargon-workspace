{
  "hooks": {
    "SessionStart": [
      {
        "type": "command",
        "command": "node ./scripts/session_start.mjs",
        "timeout": 5
      }
    ],
    "PreToolUse": [
      {
        "matcher": "^(write_to_file|WriteToFile|write_file|WriteFile|edit_file|EditFile|replace_file_content|ReplaceFileContent|multi_replace_file_content|MultiReplaceFileContent|apply_patch|write|Write|edit|Edit|multi_edit|multiedit|MultiEdit|search_replace|SearchReplace|str_replace|StrReplace|generate_document|fill_form|patch_document|redact_document|place_seal|Bash|bash|shell|Shell|run_command|RunCommand|terminal|Terminal|execute|Execute|execute_command|call_mcp_tool|CallMcpTool|mcp__.*)$",
        "hooks": [
          {
            "type": "command",
            "command": "node ./scripts/evidence_guard.mjs pre-tool-use",
            "timeout": 15
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "^(write_to_file|WriteToFile|write_file|WriteFile|edit_file|EditFile|replace_file_content|ReplaceFileContent|multi_replace_file_content|MultiReplaceFileContent|apply_patch|write|Write|edit|Edit|multi_edit|multiedit|MultiEdit|search_replace|SearchReplace|str_replace|StrReplace|generate_document|fill_form|patch_document|redact_document|place_seal|Bash|bash|shell|Shell|run_command|RunCommand|terminal|Terminal|execute|Execute|execute_command)$",
        "hooks": [
          {
            "type": "command",
            "command": "node ./scripts/evidence_guard.mjs post-tool-use",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "node ./scripts/post_tool_feedback.mjs wrap node ./scripts/hallucination_guard.mjs",
            "timeout": 30
          },
          {
            "type": "command",
            "command": "node ./scripts/post_tool_feedback.mjs wrap node ./scripts/legal_factuality_guard.mjs",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "^(read_file|ReadFile|Read|run_command|RunCommand|Bash|bash|shell|Shell|terminal|Terminal|execute|Execute|execute_command|view_file|view_file_outline|list_dir|grep_search|find_by_name|search_web|read_url_content|codebase_search|view_code_item)$",
        "hooks": [
          {
            "type": "command",
            "command": "node ./scripts/post_tool_feedback.mjs wrap node ./scripts/lookup_guard.mjs",
            "timeout": 5
          }
        ]
      }
    ],
    "PreInvocation": [
      {
        "type": "command",
        "command": "node ./scripts/post_tool_feedback.mjs inject",
        "timeout": 5
      }
    ]
  }
}
