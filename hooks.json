{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/scripts/session_start.mjs\"",
            "timeout": 5,
            "statusMessage": "LazyArgon Workspace: Loading host contract",
            "failurePolicy": "FAIL_OPEN"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "^(write_to_file|WriteToFile|write_file|WriteFile|replace_file_content|ReplaceFileContent|apply_patch|write|Write|edit|Edit|multi_edit|multiedit|MultiEdit|search_replace|SearchReplace|str_replace|StrReplace|generate_document|fill_form|Bash|bash|shell|Shell|run_command|RunCommand|terminal|Terminal|execute|Execute|execute_command)$",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/scripts/evidence_guard.mjs\" pre-tool-use",
            "timeout": 5,
            "statusMessage": "LazyArgon Workspace: Guarding Evidence Integrity (Write-Lock)",
            "failurePolicy": "FAIL_CLOSED"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "^(write_to_file|WriteToFile|write_file|WriteFile|replace_file_content|ReplaceFileContent|apply_patch|write|Write|edit|Edit|multi_edit|multiedit|MultiEdit|search_replace|SearchReplace|str_replace|StrReplace|generate_document|fill_form)$",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/scripts/evidence_guard.mjs\" post-tool-use",
            "timeout": 5,
            "statusMessage": "LazyArgon Workspace: Logging SHA-256 Audit Trail",
            "failurePolicy": "FAIL_OPEN"
          },
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/scripts/hallucination_guard.mjs\"",
            "timeout": 30,
            "statusMessage": "LazyArgon Workspace: Verifying report (보고서/검토해줘 무조건 검증)",
            "failurePolicy": "FAIL_CLOSED"
          },
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/scripts/legal_factuality_guard.mjs\"",
            "timeout": 5,
            "statusMessage": "LazyArgon Workspace: Legal factuality guard (조문/판례 날조 검증)",
            "failurePolicy": "FAIL_CLOSED"
          }
        ]
      },
      {
        "matcher": "^(Bash|bash|shell|Shell|run_command|RunCommand|terminal|Terminal|execute|Execute|execute_command)$",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/scripts/hallucination_guard.mjs\"",
            "timeout": 30,
            "statusMessage": "LazyArgon Workspace: Verifying forensic report (shell redirect)",
            "failurePolicy": "FAIL_CLOSED"
          },
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/scripts/legal_factuality_guard.mjs\"",
            "timeout": 5,
            "statusMessage": "LazyArgon Workspace: Legal factuality guard (shell redirect)",
            "failurePolicy": "FAIL_CLOSED"
          }
        ]
      },
      {
        "matcher": "^(mcp__.*|.*generate_document.*|.*fill_form.*)$",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/scripts/legal_factuality_guard.mjs\"",
            "timeout": 5,
            "statusMessage": "LazyArgon Workspace: Legal factuality guard (MCP document)",
            "failurePolicy": "FAIL_CLOSED"
          }
        ]
      }
    ],
    "PostCompact": [
      {
        "matcher": "manual|auto",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/scripts/session_start.mjs\"",
            "timeout": 5,
            "statusMessage": "LazyArgon Workspace: Restoring host contract",
            "failurePolicy": "FAIL_OPEN"
          }
        ]
      }
    ]
  }
}
